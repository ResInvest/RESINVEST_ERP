# =========================================================================
#  ResInvest ERP Serwer — zmienne środowiskowe (PRZYKŁAD, bez sekretów)
#  Wariant instalacji: Firma — konta @resinvest.group
#  Domeny kont: @resinvest.group (COMPANY_DOMAINS — odkomentuj niżej, aby zmienić)
#
#  Skopiuj ten plik jako server.env do katalogu danych serwera
#  (instalacja Windows: C:\ProgramData\ResInvestERP\server.env — instalator
#  tworzy go przy pierwszej instalacji) albo do config\server.env
#  i uzupełnij wartości. Zmienne środowiskowe systemu mają pierwszeństwo.
#
#  NIE commituj prawdziwych kluczy. Plik server.env / .env jest w .gitignore.
#  Klucze są czytane WYŁĄCZNIE przez serwer — nigdy nie trafiają do przeglądarki.
# =========================================================================

# --- Adres programu używany w linkach e-mail (zaproszenie, reset hasła) ---
# Adres, pod którym pracownicy otwierają program, np. http://192.168.1.20:8080
# albo https://erp.resinvest.group. Bez APP_URL serwer użyje własnego adresu w sieci lokalnej.
APP_URL=

# --- Poczta (Resend) ---
# Klucz API z panelu Resend (re_...). Domena resinvest.group musi być zweryfikowana w Resend.
RESEND_API_KEY=
EMAIL_FROM=ResInvest ERP <magazyn@resinvest.group>
# Adres odpowiedzi (opcjonalnie), np. magazyn@resinvest.group
EMAIL_REPLY_TO=

# --- Poczta (AgentMail) — alternatywa dla Resend ---
# Klucz API z https://console.agentmail.to (am_...) i adres skrzynki nadawcy.
# Nadawca firmy: magazyn@resinvest.group — wymaga domeny resinvest.group dodanej i zweryfikowanej w AgentMail
# (docs/EMAIL_SETUP.md, punkt 4a). Do czasu weryfikacji można użyć skrzynki np. resinvest-erp@agentmail.to.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=magazyn@resinvest.group
# Region EU (opcjonalnie): https://api.agentmail.eu
AGENTMAIL_API_URL=

# Transport: resend (domyślny, gdy jest RESEND_API_KEY) | agentmail (domyślny, gdy jest tylko AGENTMAIL_API_KEY) | smtp | file
# file = wiadomości zapisywane jako .eml w <katalog danych>\mail-outbox (bez wysyłki; testy, brak poczty)
EMAIL_TRANSPORT=smtp

# --- SMTP — poczta firmowa (EMAIL_TRANSPORT=smtp) ---
# Dowolny serwer poczty firmy. Przykłady (szczegóły: docs/EMAIL_SETUP.md, punkt 3a):
#   Microsoft 365 / Outlook:  SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_SECURE=starttls
#   Google Workspace (Gmail): SMTP_HOST=smtp.gmail.com      SMTP_PORT=465  SMTP_SECURE=ssl   (hasło aplikacji)
#   home.pl:                  SMTP_HOST=<serwer>.home.pl     SMTP_PORT=465  SMTP_SECURE=ssl
#   OVH / nazwa.pl / cyber_Folks — dane SMTP z panelu dostawcy (zwykle 465 SSL)
#   Resend:                   SMTP_HOST=smtp.resend.com      SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<klucz re_...>
# SMTP_SECURE: ssl (TLS od początku, port 465) | starttls (port 587) | none (tylko przekaźnik w sieci firmy, bez hasła).
# Puste SMTP_SECURE = ssl dla portu 465, starttls dla pozostałych. Hasło nigdy nie idzie bez szyfrowania.
# EMAIL_FROM musi być adresem skrzynki SMTP_USER (albo adresem, z którego ta skrzynka może wysyłać — „Wyślij jako”).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=starttls
SMTP_USER=magazyn@resinvest.group
SMTP_PASS=
# Opcjonalnie: nazwa komputera w powitaniu EHLO, limit czasu (ms), certyfikat własny serwera (false = nie sprawdzaj — odradzane)
SMTP_EHLO=
SMTP_TIMEOUT_MS=30000
SMTP_TLS_REJECT_UNAUTHORIZED=true

# --- Ważność linków (godziny) ---
INVITE_HOURS=72
RESET_HOURS=1
CONFIRM_HOURS=48

# --- Supabase ---
# NIEUŻYWANE: wdrożono wariant A (własny serwer Node.js + SQLite, bez Supabase) — patrz
# docs/SUPABASE_SETUP.md. Zmienne pozostawione dla zgodności z dokumentem wymagań.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# --- Folder firmy i VPN (wariant: firma) ---
# Program dla pracowników i kopie bazy: \\ue.cz\EPRPL\Data\BIOMASA (Menu Start → Opublikuj program w folderze firmy).
# Połączenie: FortiClient VPN „United Energy - VPN”. Adres VPN komputera zmienia się przy połączeniu — do APP_URL wpisz stały adres
# serwera w sieci firmy (nazwa DNS albo stały IP), np. APP_URL=http://erp-biomasa.ue.cz:8080
# Inny folder kopii: BACKUP_COPY_TO=<folder>[;<folder2>]

# --- Domeny adresów e-mail kont (wariant: firma) ---
# Domyślnie z wariantu instalacji. Aby zmienić: odkomentuj i wpisz listę domen po przecinku albo * (dowolna domena).
# COMPANY_DOMAINS=resinvest.group

# =========================================================================
#  Baza danych (od 3.15)
# =========================================================================
# DB_DRIVER=sqlite    — domyślnie: plik <katalog danych>\resinvest.sqlite (tryb jednostanowiskowy / awaryjny)
# DB_DRIVER=postgres  — tryb firmowy: centralna baza PostgreSQL 14+ (docs/POSTGRESQL.md)
DB_DRIVER=sqlite
# Połączenie z PostgreSQL — pola osobno (hasło może zawierać dowolne znaki) ALBO jeden adres DATABASE_URL.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=resinvest
DB_USER=resinvest_app
DB_PASSWORD=
# DATABASE_URL=postgres://resinvest_app:haslo@127.0.0.1:5432/resinvest
# Szyfrowanie połączenia: disable (ten sam komputer) | require (szyfrowane) | verify-full (szyfrowane + sprawdzenie certyfikatu)
DB_SSL=
# Plik certyfikatu urzędu (PEM) dla verify-full, gdy serwer bazy ma certyfikat własny
DB_SSL_CA=
# Schemat (puste = public), limity czasu w ms, czas prób ponownego połączenia po zerwaniu (s)
DB_SCHEMA=
DB_STATEMENT_TIMEOUT_MS=60000
DB_CONNECT_TIMEOUT_MS=15000
DB_RECONNECT_SECONDS=20
