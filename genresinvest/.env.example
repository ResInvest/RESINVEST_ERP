# GenResInvest 1.0 — konfiguracja środowiska
# Skopiuj jako ".env" obok programu (lub w katalogu danych). Zmienne środowiskowe GRI_* mają pierwszeństwo.

# Adres nasłuchu: 127.0.0.1 = tylko ten komputer; 0.0.0.0 = dostęp z sieci firmowej (inne komputery, telefony)
GRI_HOST=127.0.0.1
GRI_PORT=8765

# Katalog danych (baza, archiwum dokumentów, kopie, logi).
# Domyślnie: Windows (instalator) -> C:\ProgramData\GenResInvest, tryb deweloperski -> ./data
# GRI_DATA_DIR=D:\GenResInvest\dane

# Hasło startowe konta "admin" (tylko przy pierwszym uruchomieniu; puste = losowe, zapisane w HASLO_STARTOWE_ADMINA.txt)
GRI_ADMIN_PASSWORD=

# Sesja użytkownika (godziny)
GRI_SESSION_HOURS=12
# Blokada konta po nieudanych logowaniach
GRI_LOGIN_MAX_ATTEMPTS=5
GRI_LOGIN_LOCK_MINUTES=15
# Ustaw true, gdy program działa za serwerem HTTPS (reverse proxy)
GRI_SECURE_COOKIES=false

# Kopie zapasowe automatyczne: co ile godzin, ile przechowywać, czy dołączać archiwum dokumentów
GRI_BACKUP_INTERVAL_HOURS=24
GRI_BACKUP_KEEP=30
GRI_BACKUP_INCLUDE_DOCUMENTS=true

GRI_OPEN_BROWSER=true
GRI_LOG_LEVEL=INFO
