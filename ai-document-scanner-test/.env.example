# =========================================================================
#  AI Document Scanner Test — zmienne środowiskowe (PRZYKŁAD, bez sekretów)
#
#  Skopiuj jako config/server.env (albo server.env w katalogu modułu)
#  i uzupełnij. Zmienne środowiskowe systemu mają pierwszeństwo.
#  NIE commituj prawdziwych kluczy — server.env jest w .gitignore.
#  Klucze czyta WYŁĄCZNIE serwer; przeglądarka nigdy ich nie dostaje.
# =========================================================================

# --- Provider AI ---
# auto = Claude, gdy jest klucz; inaczej mock (wyniki symulowane dla przykładów)
SCANNER_PROVIDER=auto

# Klucz testowy Anthropic API (konsola: platform.claude.com → API Keys).
# Zalecenie: osobny klucz / workspace TESTOWY z limitem wydatków — nie klucz produkcyjny.
ANTHROPIC_API_KEY=

# Model i poziom staranności (low | medium | high | xhigh | max). Puste = wartości z config/scanner.config.json
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=

# --- Serwer testowy ---
SCANNER_PORT=8095
# 127.0.0.1 = tylko ten komputer. Inny adres (np. 0.0.0.0 — test z telefonu w sieci firmy)
# wymaga ustawienia SCANNER_ACCESS_TOKEN; telefon otwiera wtedy http://<ip>:8095/?token=<token>
SCANNER_HOST=127.0.0.1
SCANNER_ACCESS_TOKEN=

# Katalog IZOLOWANYCH wyników testowych (nie katalog danych ResInvest ERP — serwer odmówi startu)
SCANNER_DATA_DIR=data-test

# Plik JSON kartotek ERP do podpowiedzi dopasowania (tylko odczyt). Puste = samples/erp-master-data.sample.json
SCANNER_ERP_MASTER_DATA=
